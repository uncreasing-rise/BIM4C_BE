generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProjectCategory {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique @db.VarChar(120)
  name      String    @db.VarChar(160)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects  Project[]

  @@map("project_categories")
}

model Project {
  id                 String          @id @default(uuid()) @db.Uuid
  slug               String          @unique @db.VarChar(180)
  title              String          @db.VarChar(240)
  description        String          @db.VarChar(1000)
  image              String          @db.VarChar(500)
  eyebrow            String          @db.VarChar(160)
  meta               String?         @db.VarChar(240)
  highlights         Json
  sections           Json
  location           String          @db.VarChar(180)
  year               Int
  investor           String?         @db.VarChar(1000)
  expectedCompletion String?         @map("expected_completion") @db.VarChar(180)
  scale              String?         @db.VarChar(2000)
  contractPackage    String?         @map("contract_package") @db.VarChar(500)
  status             ProjectStatus   @default(DRAFT)
  isFeatured         Boolean         @default(false) @map("is_featured")
  sortOrder          Int             @default(0) @map("sort_order")
  categoryId         String          @map("category_id") @db.Uuid
  publishedAt        DateTime?       @map("published_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(3)
  images             ProjectImage[]
  category           ProjectCategory @relation(fields: [categoryId], references: [id])

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([createdAt])
  @@map("projects")
}

model ProjectImage {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  url       String  @db.VarChar(500)
  alt       String  @db.VarChar(240)
  sortOrder Int     @default(0) @map("sort_order")
  caption   String? @db.VarChar(500)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_images")
}

model Service {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(180)
  title       String        @db.VarChar(240)
  description String        @db.VarChar(1000)
  image       String        @db.VarChar(500)
  eyebrow     String        @db.VarChar(160)
  meta        String?       @db.VarChar(240)
  highlights  Json
  sections    Json
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0) @map("sort_order")
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  @@index([status, publishedAt])
  @@map("services")
}

model Course {
  id            String               @id @default(uuid()) @db.Uuid
  slug          String               @unique @db.VarChar(180)
  title         String               @db.VarChar(240)
  description   String               @db.VarChar(1000)
  image         String               @db.VarChar(500)
  eyebrow       String               @db.VarChar(160)
  meta          String?              @db.VarChar(240)
  highlights    Json
  sections      Json
  status        ContentStatus        @default(DRAFT)
  sortOrder     Int                  @default(0) @map("sort_order")
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz(3)
  registrations CourseRegistration[]
  curriculum    CourseSection[]

  @@index([status, publishedAt])
  @@map("courses")
}

model CourseSection {
  id          String @id @default(uuid()) @db.Uuid
  courseId    String @map("course_id") @db.Uuid
  title       String @db.VarChar(240)
  description String
  sortOrder   Int    @default(0) @map("sort_order")
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
  @@map("course_sections")
}

model PostCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(120)
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  posts     Post[]

  @@map("post_categories")
}

model Post {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(180)
  title       String        @db.VarChar(240)
  description String        @db.VarChar(1000)
  image       String        @db.VarChar(500)
  eyebrow     String        @db.VarChar(160)
  meta        String?       @db.VarChar(240)
  highlights  Json
  sections    Json
  authorName  String?       @map("author_name") @db.VarChar(160)
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0) @map("sort_order")
  categoryId  String?       @map("category_id") @db.Uuid
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)
  category    PostCategory? @relation(fields: [categoryId], references: [id])

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

model Contact {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @db.VarChar(160)
  email     String           @db.VarChar(320)
  phone     String?          @db.VarChar(32)
  company   String?          @db.VarChar(200)
  message   String           @db.VarChar(5000)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  status    SubmissionStatus @default(NEW)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([email])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("contacts")
}

model CourseRegistration {
  id        String           @id @default(uuid()) @db.Uuid
  courseId  String           @map("course_id") @db.Uuid
  name      String           @db.VarChar(160)
  email     String           @db.VarChar(320)
  phone     String           @db.VarChar(32)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  status    SubmissionStatus @default(NEW)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  course    Course           @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([email])
  @@index([status, createdAt])
  @@map("course_registrations")
}

model NewsletterSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(320)
  consent        Boolean
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  isActive       Boolean   @default(true) @map("is_active")
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([isActive, createdAt])
  @@map("newsletter_subscriptions")
}

model HeroSlide {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eyebrow   String   @db.VarChar(160)
  title     String   @db.VarChar(240)
  image     String   @db.VarChar(500)
  alt       String   @db.VarChar(240)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("hero_slides")
}

model StrategicPartner {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(180)
  logo      String   @db.VarChar(500)
  website   String?  @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("strategic_partners")
}

model Media {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String   @db.VarChar(1000)
  storageKey String   @unique @map("storage_key") @db.VarChar(500)
  filename   String   @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(120)
  size       Int
  width      Int?
  height     Int?
  alt        String?  @db.VarChar(240)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("media")
}

model AdminUser {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String          @unique @db.VarChar(320)
  name         String          @db.VarChar(160)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  status       UserStatus      @default(ACTIVE)
  lastLoginAt  DateTime?       @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     AdminSession[]
  roles        AdminUserRole[]
  auditLogs    AuditLog[]

  @@index([status, createdAt])
  @@map("admin_users")
}

model AdminUserRole {
  userId String    @map("user_id") @db.Uuid
  role   AdminRole
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("admin_user_roles")
}

model AdminSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  resource   String      @db.VarChar(80)
  resourceId String?     @map("resource_id") @db.VarChar(120)
  requestId  String?     @map("request_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      AdminUser?  @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([resource, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SiteSettings {
  id                    String   @id @default("default") @db.VarChar(32)
  companyName           String   @map("company_name") @db.VarChar(200)
  email                 String   @db.VarChar(320)
  phone                 String?  @db.VarChar(32)
  address               String?  @db.VarChar(500)
  socialLinks           Json     @map("social_links")
  defaultSeoTitle       String   @map("default_seo_title") @db.VarChar(240)
  defaultSeoDescription String   @map("default_seo_description") @db.VarChar(500)
  defaultOgImage        String?  @map("default_og_image") @db.VarChar(1000)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  PUBLISH
  ARCHIVE
  ROLE_CHANGE
  SETTINGS_UPDATE
  MEDIA_UPLOAD
  MEDIA_DELETE
}
