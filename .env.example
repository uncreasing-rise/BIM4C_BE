
DATABASE_URL=postgresql://bim4c:bim4c_dev@localhost:5432/bim4c?schema=public&connection_limit=5&pool_timeout=20
FRONTEND_URL=http://localhost:3000

# On Vercel, set these in Project Settings > Environment Variables.
# PUBLIC_API_URL=https://bim-4-c-be.vercel.app
# FRONTEND_URL=https://www.bim4c.vn
# CORS_ORIGINS=https://www.bim4c.vn,https://bim4c.vn

ADMIN_BOOTSTRAP_EMAIL=admin@bim4c.vn
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters

# FE cache revalidation; both values are optional together in development
REVALIDATION_URL=http://localhost:3000/api/revalidate
REVALIDATION_SECRET=replace-with-at-least-32-random-characters

# Media storage (local by default)
MEDIA_STORAGE_DRIVER=local

# Required only when MEDIA_STORAGE_DRIVER=supabase
# SUPABASE_URL=https://project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_MEDIA_BUCKET=media

# Optional overrides (defaults shown)
# NODE_ENV=development
# PORT=8080
# PUBLIC_API_URL=http://localhost:8080
# CORS_ORIGINS=http://localhost:3000
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=30
# AUTH_COOKIE_NAME=bim4c_admin_session
# AUTH_COOKIE_DOMAIN=.bim4c.vn
# lax | strict | none (none requires production/HTTPS)
# AUTH_COOKIE_SAME_SITE=lax
# IANA timezone that availability rules (e.g. 09:00-17:00) are written in
# APPOINTMENT_TIMEZONE=Asia/Ho_Chi_Minh
# Signs the Google OAuth `state`; falls back to REVALIDATION_SECRET
# OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
# AUTH_SESSION_TTL_HOURS=8
# MEDIA_STORAGE_PATH=uploads
# TEMPORARY_ADMIN_AUTH=false
# ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# Appointment email notifications (Resend)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# MAIL_FROM="BIM4C <no-reply@bim4c.vn>"
# APPOINTMENT_ADMIN_EMAIL=your-team@bim4c.vn

# Google Calendar + automatic Google Meet on confirmation
# GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-bot@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=C:\\secure\\gen-lang-client-key.json
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# GOOGLE_CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
# GOOGLE_OAUTH_CLIENT_FILE=C:\\secure\\client_secret.json
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token
# GOOGLE_OAUTH_TOKEN_FILE=.google-oauth-token.json
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/admin/appointments/google/callback
