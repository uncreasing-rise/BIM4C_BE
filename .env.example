# Set NODE_ENV=production in production.
NODE_ENV=development
PORT=8080
# Required, server-only PostgreSQL connection string.
DATABASE_URL=postgresql://bim4c:bim4c_dev@localhost:5432/bim4c?schema=public
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=30
TEMPORARY_ADMIN_AUTH=false
AUTH_COOKIE_NAME=bim4c_admin_session
AUTH_SESSION_TTL_HOURS=8
ADMIN_BOOTSTRAP_EMAIL=admin@bim4c.vn
# Set ADMIN_BOOTSTRAP_PASSWORD only in the server-side deployment environment.
REVALIDATION_URL=http://localhost:3000/api/revalidate
# Required in production and identical to the FE server-only value.
REVALIDATION_SECRET=replace-with-at-least-32-random-characters
MEDIA_STORAGE_DRIVER=local
PUBLIC_API_URL=http://localhost:8080
MEDIA_STORAGE_PATH=uploads
# Required only when MEDIA_STORAGE_DRIVER=supabase; all are server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media
